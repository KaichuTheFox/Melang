{
  "name": "melang",
  "displayName": "Melang",
  "description": "Language support and native execution for Melang (.m).",
  "version": "0.1.0",
  "publisher": "melang-local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./src/extension.js",
  "files": ["language-configuration.json", "snippets", "src", "syntaxes"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "languages": [{
      "id": "melang",
      "aliases": ["Melang"],
      "extensions": [".m"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "melang",
      "scopeName": "source.melang",
      "path": "./syntaxes/melang.tmLanguage.json"
    }],
    "snippets": [{
      "language": "melang",
      "path": "./snippets/melang.json"
    }],
    "commands": [{ "command": "melang.run", "title": "Melang: Run Current File" }],
    "problemMatchers": [{
      "name": "melang",
      "owner": "melang",
      "source": "Melang",
      "fileLocation": "absolute",
      "pattern": {
        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error)\\s+(ML\\d+):\\s+(.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "code": 5,
        "message": 6
      }
    }],
    "menus": {
      "editor/title": [{ "command": "melang.run", "when": "resourceLangId == melang" }]
    },
    "configuration": {
      "title": "Melang",
      "properties": {
        "melang.executablePath": {
          "type": "string",
          "scope": "resource",
          "default": "melang",
          "description": "Melang executable name on PATH or the full path to melang.exe."
        },
        "melang.liveDiagnostics": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Check unsaved Melang edits in trusted workspace folders."
        }
      }
    }
  }
}
